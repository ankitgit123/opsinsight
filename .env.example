
# Application
APP_NAME=OpsInsight
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# MySQL
MYSQL_ROOT_PASSWORD=opsinsight_root_dev
MYSQL_DATABASE=opsinsight_app
MYSQL_USER=opsinsight_user
MYSQL_PASSWORD=opsinsight_dev_password
MYSQL_PORT=3307

# Application database connection
DATABASE_URL=mysql+pymysql://opsinsight_user:opsinsight_dev_password@mysql:3306/opsinsight_app

# LLM Provider
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:4b
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=ollama

# Agent
AGENT_FRAMEWORK=native
AGENT_MAX_STEPS=5
AGENT_TIMEOUT_SECONDS=60

# Upload
MAX_UPLOAD_SIZE_MB=20

# Observability
LANGFUSE_ENABLED=false
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=
